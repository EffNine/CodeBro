-    pub fn save(&self, _path: &Path) -> std::io::Result<()> {
-        unimplemented!()
+    pub fn save(&self, path: &Path) -> std::io::Result<()> {
+        use std::fs;
+        use std::io::Write;
+
+        let mut file = fs::File::create(path)?;
+        let entries = self.list();
+        for (id, title) in entries {
+            writeln!(file, "{}:{}", id, title)?;
+        }
+        Ok(())
     }
 
-    pub fn load(_path: &Path) -> std::io::Result<Self> {
-        unimplemented!()
+    pub fn load(path: &Path) -> std::io::Result<Self> {
+        use std::fs;
+
+        let content = fs::read_to_string(path)?;
+        let mut tasks = HashMap::new();
+        for line in content.lines() {
+            if line.is_empty() {
+                continue;
+            }
+            let split = line.split_once(':').ok_or_else(|| {
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidData,
+                    format!("malformed line: {}", line),
+                )
+            })?;
+            let (id, title) = split;
+            tasks.insert(id.to_string(), title.to_string());
+        }
+        Ok(Self { tasks })
     }
 
     // --- Step 4 ---
-    pub fn rename(&mut self, _id: &str, _new_title: &str) -> Result<(), String> {
-        unimplemented!()
+    pub fn rename(&mut self, id: &str, new_title: &str) -> Result<(), String> {
+        if new_title.is_empty() {
+            return Err("empty title".to_string());
+        }
+        match self.tasks.get_mut(id) {
+            Some(title) => {
+                *title = new_title.to_string();
+                Ok(())
+            }
+            None => Err(format!("unknown id: {}", id)),
+        }
     }
 }

