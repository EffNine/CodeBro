+        if new_title.is_empty() {
+            return Err("new_title must not be empty".to_string());
+        }
+        match self.tasks.get_mut(id) {
+            Some(title) => {
+                *title = new_title.to_string();
+                Ok(())
+            }
+            None => Err(format!("unknown id: {id}")),
