+pub fn apply_batch(files: &[(PathBuf, String)]) -> Result<(), ApplyError> {
+    if files.is_empty() {
+        return Ok(());
+    }
+
+    // Capture prior state for every path that will be written.
+    // In-memory backups only — never extra files in the target tree.
+    // `Some(bytes)` = file existed before; `None` = this call will create it.
+    let mut backups: Vec<(PathBuf, Option<Vec<u8>>)> = Vec::with_capacity(files.len());
+
+    for (path, content) in files {
+        let prior = if path.exists() {
+            match std::fs::read(path) {
+                Ok(bytes) => Some(bytes),
+                Err(_) => {
+                    // Can't read prior content — treat as created-by-us; on
+                    // rollback we'll attempt to delete.
+                    None
+                }
+            }
+        } else {
+            None
+        };
+        backups.push((path.clone(), prior));
+
+        // Create parent directories if needed.
+        if let Some(parent) = path.parent() {
+            if !parent.exists() {
+                std::fs::create_dir_all(parent).map_err(|e| {
+                    ApplyError::WriteFailed {
+                        path: path.clone(),
+                        message: format!(
+                            "failed to create parent directory {}: {}",
+                            parent.display(),
+                            e
+                        ),
+                    }
+                })?;
+            }
+        }
+
+        match std::fs::write(path, content) {
+            Ok(()) => {}
+            Err(e) => {
+                // Write failed — roll back every file we wrote in this call.
+                let mut restored: Vec<PathBuf> = Vec::new();
+                let mut failed: Vec<PathBuf> = Vec::new();
+
+                // Iterate in reverse so we restore the most-recent write first.
+                for i in (0..files.len()).rev() {
+                    if i >= backups.len() {
+                        continue;
+                    }
+                    let (path, prior) = &backups[i];
+                    let ok = match prior {
+                        Some(bytes) => std::fs::write(path, bytes).is_ok(),
+                        None => std::fs::remove_file(path).is_ok()
+                            || !path.exists(),
+                    };
+                    if ok {
+                        restored.push(path.clone());
+                    } else {
+                        failed.push(path.clone());
+                    }
+                }
+
+                if failed.is_empty() {
+                    Err(ApplyError::WriteFailed {
+                        path: path.clone(),
+                        message: e.to_string(),
+                    })
+                } else {
+                    Err(ApplyError::RollbackIncomplete {
+                        restored,
+                        failed,
+                    })
+                }
+            }
+        }
+    }
+
+    Ok(())
 }
 
