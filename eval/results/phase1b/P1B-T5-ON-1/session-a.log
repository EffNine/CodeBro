fect_recency() {\n        let mut c = Cache::new(3);","lineStart":90,"lineEnd":119,"totalLines":186,"truncated":true}},"title":"tmp/opencode/phase1b/P1B-T5-ON-1/work/src/lib.rs","time":{"start":1789578613816,"end":1789578613822}},"id":"prt_0ab3292c3001tp2ymkqQ6q040F","sessionID":"ses_f54d012c1ffeVAia3LAf67snK5","messageID":"msg_0ab32809a0015Ew2pFL5RNHGaQ"}}
