ption<String>>`... Simplest: Node holds key. But on replace, move_to_tail updates val only; key unchanged. On evict: `let key = node.key; self.slots.remove(&key);` ✓.\n\nNode { key: String, val: String, prev, next }.\n\nIn append: Node::new(key.clone()...). I'll write the full code:\n\n```rust\n//! Small bounded cache (evaluation fixture). Bounded by `cap` with O(1)\n//! write-recency eviction: when full, the oldest entry (by last `put`) is\n//! evicted. `get` does not refresh recency. See `spec.md` and `NOTES.md`.\n\nuse std::collections::HashMap;\n\nstruct Node {\n    key: String,\n    val: String,\n    prev: Option<usize>,\n    next: Option<usize>,\n}\n\npub struct Cache {\n    cap: usize,\n    slots: HashMap<String, usize>,\n    nodes: Vec<Option<Node>>,\n    free: Vec<usize>,\n    head: Option<usize>,\n    tail: Option<usize>,\n    evicted: u64,\n}\n\nimpl Cache {\n    /// Creates an empty cache holding at most `cap` entries. Panics if `cap == 0`.\n    pub fn new(cap: usize) -> Self {\n        assert!(cap > 0, \"capacity must be non-zero\");\n        Self {\n            cap,\n            slots: HashMap::new(),\n            nodes: Vec::new(),\n            free: Vec::new(),\n            head: None,\n            tail: None,\n            evicted: 0,\n        }\n    }\n\n    /// Inserts or replaces `key`. Counts as the newest entry.\n    pub fn put(&mut self, key: String, val: String) {\n        if let Some(&i) = self.slots.get(&key) {\n            self.refresh(i, val);\n        } else {\n            if self.slots.len() == self.cap {\n                self.evict_oldest();\n            }\n            self.append(key, val);\n        }\n    }\n\n    /// Looks up `key`. Does not affect recency.\n    pub fn get(&self, key: &str) -> Option<String> {\n        self.slots\n            .get(key)\n            .and_then(|&i| self.nodes[i].as_ref().map(|n| n.val.clone()))\n    }\n\n    /// Number of entries currently stored.\n    pub fn len(&self) -> usize {\n        self.slots.len()\n    }\n\n    /// Total entries removed due to capacity since creation.\n    pub fn evictions(&self) -> u64 {\n        self.evicted\n    }\n\n    fn alloc_slot(&mut self) -> usize {\n        match self.free.pop() {\n            Some(i) => i,\n            None => {\n                self.nodes.push(None);\n                self.nodes.len() - 1\n            }\n        }\n    }\n\n    fn append(&mut self, key: String, val: String) {\n        let i = self.alloc_slot();\n        let prev = self.tail;\n        if let Some(t) = prev {\n            self.nodes[t].as_mut().unwrap().next = Some(i);\n        }\n        self.nodes[i] = Some(Node {\n            key,\n            val,\n            prev,\n            next: None,\n        });\n        self.head = self.head.or(Some(i));\n        self.tail = Some(i);\n    }\n\n    fn evict_oldest(&mut self) {\n        let h = self.head.take().expect(\"cache is full, so it is non-empty\");\n        let node = self.nodes[h].take().expect(\"head slot is live\");\n        self.head = node.next;\n        if let Some(nh) = self.head {\n            self.nodes[nh].as_mut().unwrap().prev = None;\n        }\n        self.slots.remove(&node.key);\n        self.free.push(h);\n        self.evicted += 1;\n    }\n\n    fn refresh(&mut self, i: usize, val: String) {\n        let (prev, next) = {\n            let n = self.nodes[i].as_mut().unwrap();\n            (n.prev.take(), n.next.take())\n        };\n        match (prev, next) {\n            (None, None) => {\n                self.head = None;\n                self.tail = None;\n            }\n            (None, Some(n)) => self.head = Some(n),\n            (Some(p), None) => self.tail = Some(p),\n            (Some(_), Some(_)) => {}\n        }\n        if let Some(p) = prev {\n            self.nodes[p].as_mut().unwrap().next = next;\n        }\n        if let Some(n) = next {\n            self.nodes[n].as_mut().unwrap().prev = prev;\n        }\n        if let Some(t) = self.tail {\n            self.nodes[t].as_mut().unwrap().next = Some(i);\n        }\n        let n = self.nodes[i].as_mut().unwrap();\n        n.prev = self.tail;\n        n.next = None;\n        n.val = val;\n        self.head = self.head.or(Some(i));\n        self.tail = Some(i);\n    }\n}\n```\n\nWait, in refresh, the order of setting `n.prev = self.tail` and then `self.head = self.head.or(Some(i)); self.tail = Some(i);` — when tail is None (empty list after unlink), head.or(Some(i)) sets head = i, and tail = i ✓.\n\nCheck borrow: `match (prev, next)` uses Option<usize> copies — fine. Then `if let Some(p) = prev` — prev consumed? prev is Option<usize> (Copy) — fine, match doesn't consume (Copy types are used by value in match pattern without move semantics; match on Copy types does not move). ✓\n\nBorrow issue in refresh: `if let Some(t) = self.tail { self.nodes[t]...next = Some(i); }` — then `let n = self.nodes[i].as_mut().unwrap();` — if t == i... proved impossible. If t != i, both are separate indices but the same `self.nodes` Vec — sequential borrows, fine.\n\nappend: `if let Some(t) = prev { self.nodes[t]... }` where prev = old tail; i is a new slot (different index; i is either new allocation or a freed slot not in the list) ✓.\n\nevict_oldest: `self.nodes[h].take()` — h is live ✓.\n\nOne more consideration: `slots.len() == self.cap` — cap ≥ 1 always (asserted). When full and new key: evict exactly one, then append → len stays at cap ✓.\n\nNow, tests module. Replace existing tests with a broader set:\n\n```rust\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn visible_put_get() { ... keep existing as-is ... }\n\n    #[test]\n    fn visible_update_no_evict() { ... keep ... }\n\n    #[test]\n    fn new_panic_zero_cap() {\n        #[allow(clippy::panicking_unreachable...)] // just:\n        let result = std::panic::catch_unwind(|| Cache::new(0));\n        assert!(result.is_err());\n    }\n\n    #[test]\n    fn evicts_oldest_when_full() {\n        let mut c = Cache::new(2);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"b\".into(), \"2\".into());\n        c.put(\"c\".into(), \"3\".into());\n        assert_eq!(c.get(\"a\"), None);\n        assert_eq!(c.get(\"b\"), Some(\"2\".into()));\n        assert_eq!(c.get(\"c\"), Some(\"3\".into()));\n        assert_eq!(c.len(), 2);\n        assert_eq!(c.evictions(), 1);\n    }\n\n    #[test]\n    fn replace_marks_newest() {\n        let mut c = Cache::new(2);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"b\".into(), \"2\".into());\n        c.put(\"a\".into(), \"10\".into());\n        c.put(\"c\".into(), \"3\".into());\n        assert_eq!(c.get(\"a\"), Some(\"10\".into()));\n        assert_eq!(c.get(\"b\"), None);\n        assert_eq!(c.get(\"c\"), Some(\"3\".into()));\n        assert_eq!(c.evictions(), 1);\n    }\n\n    #[test]\n    fn get_does_not_refresh() {\n        let mut c = Cache::new(2);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"b\".into(), \"2\".into());\n        assert_eq!(c.get(\"a\"), Some(\"1\".into()));\n        c.put(\"c\".into(), \"3\".into());\n        assert_eq!(c.get(\"a\"), None);\n        assert_eq!(c.get(\"b\"), Some(\"2\".into()));\n        assert_eq!(c.evictions(), 1);\n    }\n\n    #[test]\n    fn eviction_counts_accumulate() {\n        let mut c = Cache::new(1);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"b\".into(), \"2\".into());\n        c.put(\"c\".into(), \"3\".into());\n        assert_eq!(c.get(\"c\"), Some(\"3\".into()));\n        assert_eq!(c.get(\"b\"), None);\n        assert_eq!(c.len(), 1);\n        assert_eq!(c.evictions(), 2);\n    }\n\n    #[test]\n    fn reinsert_evicted_key() {\n        let mut c = Cache::new(2);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"b\".into(), \"2\".into());\n        c.put(\"c\".into(), \"3\".into()); // evicts a\n        c.put(\"a\".into(), \"1\".into()); // evicts b (oldest)\n        assert_eq!(c.get(\"b\"), None);\n        assert_eq!(c.get(\"c\"), Some(\"3\".into()));\n        assert_eq!(c.get(\"a\"), Some(\"1\".into()));\n        assert_eq!(c.evictions(), 2);\n    }\n\n    #[test]\n    fn churn_matches_total_minus_cap() {\n        let mut c = Cache::new(100);\n        for i in 0..10_000 {\n            c.put(format!(\"k{i}\"), format!(\"v{i}\"));\n        }\n        assert_eq!(c.len(), 100);\n        assert_eq!(c.evictions(), 10_000 - 100);\n        // most recent 100 remain\n        assert_eq!(c.get(\"k9999\"), Some(\"v9999\".into()));\n        assert_eq!(c.get(\"k9899\"), Some(\"v9899\".into()));\n        assert_eq!(c.get(\"k9900\"), None);\n    }\n}\n```\n\nChurn test: 10,000 sequential distinct keys, cap 100: first 100 fill it, each subsequent new-key put evicts exactly one → evictions = 9900 ✓. Remaining: k9900..k9999. k9899 evicted ✓ (evicted when k9999 was inserted; the last evicted was k9899). Wait: the last inserted is k9999, which evicted k9899 ✓. So retained = k9900–","time":{"start":1789579259301,"end":1789579401070}}}
