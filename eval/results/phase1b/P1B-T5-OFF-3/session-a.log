 visible_update_no_evict() {\n58:         let mut c = Cache::new(2);\n59:         c.put(\"a\".into(), \"1\".into());\n60:         c.put(\"a\".into(), \"2\".into());\n61:         assert_eq!(c.get(\"a\"), Some(\"2\".to_string()));\n62:         assert_eq!(c.len(), 1);\n63:         assert_eq!(c.evictions(), 0);\n64:     }\n65: }\n\n(End of file - total 65 lines)\n</content>","metadata":{"preview":"//! Tiny bounded cache (eval fixture). Eviction follows NOTES.md. See `spec.md`.\nuse std::collections::HashMap;\n\npub struct Cache {\n    cap: usize,\n    map: HashMap<String, String>,\n    evicted: u64,\n}\n\nimpl Cache {\n    pub fn new(cap: usize) -> Self {\n        assert!(cap > 0, \"capacity must be nonzero\");\n        Self { cap, map: HashMap::new(), evicted: 0 }\n    }\n\n    pub fn put(&mut self, key: String, val: String) {\n        if self.map.contains_key(&key) {\n            self.map.insert(key, val);\n            return;\n        }","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/opencode/phase1b/P1B-T5-OFF-3/work/src/lib.rs","text":"//! Tiny bounded cache (eval fixture). Eviction follows NOTES.md. See `spec.md`.\nuse std::collections::HashMap;\n\npub struct Cache {\n    cap: usize,\n    map: HashMap<String, String>,\n    evicted: u64,\n}\n\nimpl Cache {\n    pub fn new(cap: usize) -> Self {\n        assert!(cap > 0, \"capacity must be nonzero\");\n        Self { cap, map: HashMap::new(), evicted: 0 }\n    }\n\n    pub fn put(&mut self, key: String, val: String) {\n        if self.map.contains_key(&key) {\n            self.map.insert(key, val);\n            return;\n        }\n        if self.map.len() >= self.cap {\n            // NOTES.md approach: bulk clear when full.\n            self.evicted += self.map.len() as u64;\n            self.map.clear();\n        }\n        self.map.insert(key, val);\n    }\n\n    pub fn get(&self, key: &str) -> Option<String> {\n        self.map.get(key).cloned()\n    }\n\n    pub fn len(&self) -> usize {\n        self.map.len()\n    }\n\n    pub fn evictions(&self) -> u64 {\n        self.evicted\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn visible_put_get() {\n        let mut c = Cache::new(4);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"b\".into(), \"2\".into());\n        assert_eq!(c.get(\"a\"), Some(\"1\".to_string()));\n        assert_eq!(c.get(\"zz\"), None);\n        assert_eq!(c.len(), 2);\n    }\n\n    #[test]\n    fn visible_update_no_evict() {\n        let mut c = Cache::new(2);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"a\".into(), \"2\".into());\n        assert_eq!(c.get(\"a\"), Some(\"2\".to_string()));\n        assert_eq!(c.len(), 1);\n        assert_eq!(c.evictions(), 0);\n    }\n}","lineStart":1,"lineEnd":65,"totalLines":65,"truncated":false}},"title":"tmp/opencode/phase1b/P1B-T5-OFF-3/work/src/lib.rs","time":{"start":1789580008933,"end":1789580008939}},"id":"prt_0ab47dd840016Piv07ub1rxyAK","sessionID":"ses_f54b85b12ffeoYneuJUbswHmKm","messageID":"msg_0ab47d138001poXn2CLz2aZna0"}}
