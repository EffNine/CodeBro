{"type":"tool_use","timestamp":1789803655990,"sessionID":"ses_f4763d27dffeY5LlF5AvgFiGyq","part":{"type":"tool","tool":"read","callID":"call_7ac066ea7a8b42a4962c1026","state":{"status":"completed","input":{"filePath":"/tmp/opencode/dogfood/D2-OFF-1/work/src/lib.rs"},"output":"<path>/tmp/opencode/dogfood/D2-OFF-1/work/src/lib.rs</path>\n<type>file</type>\n<content>\n1: //! Tiny bounded cache (eval fixture). Eviction follows NOTES.md. See `spec.md`.\n2: use std::collections::HashMap;\n3: \n4: pub struct Cache {\n5:     cap: usize,\n6:     map: HashMap<String, String>,\n7:     evicted: u64,\n8: }\n9: \n10: impl Cache {\n11:     pub fn new(cap: usize) -> Self {\n12:         assert!(cap > 0, \"capacity must be nonzero\");\n13:         Self { cap, map: HashMap::new(), evicted: 0 }\n14:     }\n15: \n16:     pub fn put(&mut self, key: String, val: String) {\n17:         if self.map.contains_key(&key) {\n18:             self.map.insert(key, val);\n19:             return;\n20:         }\n21:         if self.map.len() >= self.cap {\n22:             // NOTES.md approach: bulk clear when full.\n23:             self.evicted += self.map.len() as u64;\n24:             self.map.clear();\n25:         }\n26:         self.map.insert(key, val);\n27:     }\n28: \n29:     pub fn get(&self, key: &str) -> Option<String> {\n30:         self.map.get(key).cloned()\n31:     }\n32: \n33:     pub fn len(&self) -> usize {\n34:         self.map.len()\n35:     }\n36: \n37:     pub fn evictions(&self) -> u64 {\n38:         self.evicted\n39:     }\n40: }\n41: \n42: #[cfg(test)]\n43: mod tests {\n44:     use super::*;\n45: \n46:     #[test]\n47:     fn visible_put_get() {\n48:         let mut c = Cache::new(4);\n49:         c.put(\"a\".into(), \"1\".into());\n50:         c.put(\"b\".into(), \"2\".into());\n51:         assert_eq!(c.get(\"a\"), Some(\"1\".to_string()));\n52:         assert_eq!(c.get(\"zz\"), None);\n53:         assert_eq!(c.len(), 2);\n54:     }\n55: \n56:     #[test]\n57:     fn visible_update_no_evict() {\n58:         let mut c = Cache::new(2);\n59:         c.put(\"a\".into(), \"1\".into());\n60:         c.put(\"a\".into(), \"2\".into());\n61:         assert_eq!(c.get(\"a\"), Some(\"2\".to_string()));\n62:         assert_eq!(c.len(), 1);\n63:         assert_eq!(c.evictions(), 0);\n64:     }\n65: }\n\n(End of file - total 65 lines)\n</content>","metadata":{"preview":"//! Tiny bounded cache (eval fixture). Eviction follows NOTES.md. See `spec.md`.\nuse std::collections::HashMap;\n\npub struct Cache {\n    cap: usize,\n    map: HashMap<String, String>,\n    evicted: u64,\n}\n\nimpl Cache {\n    pub fn new(cap: usize) -> Self {\n        assert!(cap > 0, \"capacity must be nonzero\");\n        Self { cap, map: HashMap::new(), evicted: 0 }\n    }\n\n    pub fn put(&mut self, key: String, val: String) {\n        if self.map.contains_key(&key) {\n            self.map.insert(key, val);\n            return;\n        }","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/opencode/dogfood/D2-OFF-1/work/src/lib.rs","text":"//! Tiny bounded cache (eval fixture). Eviction follows NOTES.md. See `spec.md`.\nuse std::collections::HashMap;\n\npub struct Cache {\n    cap: usize,\n    map: HashMap<String, String>,\n    evicted: u64,\n}\n\nimpl Cache {\n    pub fn new(cap: usize) -> Self {\n        assert!(cap > 0, \"capacity must be nonzero\");\n        Self { cap, map: HashMap::new(), evicted: 0 }\n    }\n\n    pub fn put(&mut self, key: String, val: String) {\n        if self.map.contains_key(&key) {\n            self.map.insert(key, val);\n            return;\n        }\n        if self.map.len() >= self.cap {\n            // NOTES.md approach: bulk clear when full.\n            self.evicted += self.map.len() as u64;\n            self.map.clear();\n        }\n        self.map.insert(key, val);\n    }\n\n    pub fn get(&self, key: &str) -> Option<String> {\n        self.map.get(key).cloned()\n    }\n\n    pub fn len(&self) -> usize {\n        self.map.len()\n    }\n\n    pub fn evictions(&self) -> u64 {\n        self.evicted\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn visible_put_get() {\n        let mut c = Cache::new(4);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"b\".into(), \"2\".into());\n        assert_eq!(c.get(\"a\"), Some(\"1\".to_string()));\n        assert_eq!(c.get(\"zz\"), None);\n        assert_eq!(c.len(), 2);\n    }\n\n    #[test]\n    fn visible_update_no_evict() {\n        let mut c = Cache::new(2);\n        c.put(\"a\".into(), \"1\".into());\n        c.put(\"a\".into(), \"2\".into());\n        assert_eq!(c.get(\"a\"), Some(\"2\".to_string()));\n        assert_eq!(c.len(), 1);\n        assert_eq!(c.evictions(), 0);\n    }\n}","lineStart":1,"lineEnd":65,"totalLines":65,"truncated":false}},"title":"tmp/opencode/dogfood/D2-OFF-1/work/src/lib.rs","time":{"start":1789803655981,"end":1789803655987}},"id":"prt_0b89c7328001vAmAht5zwDWfq2","sessionID":"ses_f4763d27dffeY5LlF5AvgFiGyq","messageID":"msg_0b89c61bb001PS4E2oFRvwodGc"}}
