 assert!(cap > 0, \"capacity must be nonzero\");\n        Self { cap, map: HashMap::new(), evicted: 0 }\n    }\n\n    pub fn put(&mut self, key: String, val: String) {\n        if self.map.contains_key(&key) {\n            self.map.insert(key, val);\n            return;\n        }","truncated":true,"loaded":[],"display":{"type":"file","path":"/tmp/opencode/phase1b/P1B-T5-OFF-2/work/src/lib.rs","text":"//! Tiny bounded cache (eval fixture). Eviction follows NOTES.md. See `spec.md`.\nuse std::collections::HashMap;\n\npub struct Cache {\n    cap: usize,\n    map: HashMap<String, String>,\n    evicted: u64,\n}\n\nimpl Cache {\n    pub fn new(cap: usize) -> Self {\n        assert!(cap > 0, \"capacity must be nonzero\");\n        Self { cap, map: HashMap::new(), evicted: 0 }\n    }\n\n    pub fn put(&mut self, key: String, val: String) {\n        if self.map.contains_key(&key) {\n            self.map.insert(key, val);\n            return;\n        }\n        if self.map.len() >= self.cap {\n            // NOTES.md approach: bulk clear when full.\n            self.evicted += self.map.len() as u64;\n            self.map.clear();\n        }\n        self.map.insert(key, val);\n    }\n\n    pub fn get(&self, key: &str) -> Option<String> {\n        self.map.get(key).cloned()\n    }\n\n    pub fn len(&self) -> usize {\n        self.map.len()\n    }\n\n    pub fn evictions(&self) -> u64 {\n        self.evicted\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n","lineStart":1,"lineEnd":45,"totalLines":105,"truncated":true}},"title":"tmp/opencode/phase1b/P1B-T5-OFF-2/work/src/lib.rs","time":{"start":1789579190345,"end":1789579190350}},"id":"prt_0ab3b5f60001oJT5c4Iq28flid","sessionID":"ses_f54c6f319ffeGXjOodfc8mDvw5","messageID":"msg_0ab3b54fd001LFBGpSqx9eUqwh"}}
