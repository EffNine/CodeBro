:new(3);\n+        // 9 distinct keys, each new put at full state clears 3\n+        for i in 0..9 {\n+            c.put(format!(\"k{}\", i), i.to_string());\n+        }\n+        // Puts 0,1,2: len grows 1->2->3, no clear.\n+        // Puts 3..8: each new key finds len==3 -> clear 3, insert -> len 1.\n+        // But put 4 sees len 1 (not full), put 5 len 2, put 6 len 3 (not full...\n+        // wait put 6: after put 5 len==2, not full, insert -> len 3.\n+        // Let's trace: k3:clear3(=3),len1; k4:len2; k5:len3; k6:clear3(=6),len1;\n+        // k7:len2; k8:len3.\n+        assert_eq!(c.len(), 3);\n+        assert_eq!(c.evictions(), 6);\n+        assert_eq!(c.get(\"k8\"), Some(\"8\".to_string()));\n+        assert_eq!(c.get(\"k5\"), None);\n+    }\n }\n","filediff":{"file":"/tmp/opencode/phase1b/P1B-T5-OFF-2/work/src/lib.rs","patch":"Index: /tmp/opencode/phase1b/P1B-T5-OFF-2/work/src/lib.rs\n===================================================================\n--- /tmp/opencode/phase1b/P1B-T5-OFF-2/work/src/lib.rs\n+++ /tmp/opencode/phase1b/P1B-T5-OFF-2/work/src/lib.rs\n@@ -101,5 +101,24 @@\n     fn new_panics_at_zero() {\n         let result = std::panic::catch_unwind(|| Cache::new(0));\n         assert!(result.is_err());\n     }\n+\n+    #[test]\n+    fn heavy_churn_counts_every_clear() {\n+        let mut c = Cache::new(3);\n+        // 9 distinct keys, each new put at full state clears 3\n+        for i in 0..9 {\n+            c.put(format!(\"k{}\", i), i.to_string());\n+        }\n+        // Puts 0,1,2: len grows 1->2->3, no clear.\n+        // Puts 3..8: each new key finds len==3 -> clear 3, insert -> len 1.\n+        // But put 4 sees len 1 (not full), put 5 len 2, put 6 len 3 (not full...\n+        // wait put 6: after put 5 len==2, not full, insert -> len 3.\n+        // Let's trace: k3:clear3(=3),len1; k4:len2; k5:len3; k6:clear3(=6),len1;\n+        // k7:len2; k8:len3.\n+        assert_eq!(c.len(), 3);\n+        assert_eq!(c.evictions(), 6);\n+        assert_eq!(c.get(\"k8\"), Some(\"8\".to_string()));\n+        assert_eq!(c.get(\"k5\"), None);\n+    }\n }\n","additions":19,"deletions":0},"truncated":false},"title":"tmp/opencode/phase1b/P1B-T5-OFF-2/work/src/lib.rs","time":{"start":1789579207367,"end":1789579207375}},"id":"prt_0ab3b8bc3001516gnVJ7MswpB1","sessionID":"ses_f54c6f319ffeGXjOodfc8mDvw5","messageID":"msg_0ab3b6069001DK5UMekxTJoj4C"}}
