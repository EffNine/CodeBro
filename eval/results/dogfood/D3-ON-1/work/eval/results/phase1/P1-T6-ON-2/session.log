+pub fn apply_batch(files: &[(PathBuf, String)]) -> Result<(), ApplyError> {
+    // Prior state of every target, recorded before any write.
+    let mut prior: Vec<(PathBuf, Option<Vec<u8>>)> = files
+        .iter()
+        .map(|(path, _)| Ok((path.clone(), std::fs::read(path).ok().filter(|b| !b.is_empty()).or_else(|| std::fs::read(path).ok()))))
+        .collect::<Result<_, _>>()
+        .unwrap_or_default();
+    // The above is wrong: we need to distinguish "existed with bytes" from
+    // "existed empty" from "did not exist". Redo it properly below.
+    let mut prior: Vec<(PathBuf, Option<Vec<u8>>)> = files
+        .iter()
+        .map(|(path, _)| match std::fs::metadata(path) {
+            Ok(m) if m.is_file() => Ok((path.clone(), Some(std::fs::read(path).unwrap_or_default()))),
+            _ => Ok((path.clone(), None)),
+        })
+        .collect::<Result<Vec<_>, ()>>()
+        .map_err(|()| ApplyError::WriteFailed {
+            path: files[0].0.clone(),
+            message: "failed to snapshot prior state".to_string(),
+        })
+        .unwrap_or_default();
+
+    let mut created: Vec<PathBuf> = Vec::new();
+    let mut idx = 0;
+    for (i, (path, content)) in files.iter().enumerate() {
+        match write_one(path, content) {
+            Ok(()) => {
+                if prior[i].1.is_none() {
+                    created.push(path.clone());
+                }
+                idx = i;
+            }
+            Err(e) => {
+                // Roll back entries 0..=i in reverse order.
+                let mut restored: Vec<PathBuf> = Vec::new();
+                let mut failed: Vec<PathBuf> = Vec::new();
+                for j in (0..=i).rev() {
+                    let j_path = &files[j].0;
+                    let ok = match &prior[j].1 {
+                        Some(bytes) => write_one(j_path, std::str::from_utf8(bytes).unwrap_or("")).is_ok()
+                            || std::fs::write(j_path, bytes).is_ok(),
+                        None => std::fs::remove_file(j_path).is_ok(),
+                    };
+                    if ok {
+                        restored.push(j_path.clone());
+                    } else {
+                        failed.push(j_path.clone());
+                    }
+                }
+                if failed.is_empty() {
+                    let _ = created;
+                    Err(ApplyError::WriteFailed {
+                        path: path.clone(),
+                        message: e.to_string(),
+                    })
+                } else {
+                    Err(ApplyError::RollbackIncomplete { restored, failed })
+                }
+            }
+        }
+    }
+    let _ = idx;
+    Ok(())
+}
