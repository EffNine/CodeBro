use batchapply::{apply_batch, ApplyError};
use std::path::PathBuf;

fn main() {
    let d = std::env::temp_dir().join("t6_mid_999");
    let _ = std::fs::remove_dir_all(&d);
    std::fs::create_dir_all(&d).unwrap();
    let pre = d.join("pre.txt");
    std::fs::write(&pre, "original-bytes").unwrap();

    // pre-existing file, mid-batch failure on 3rd entry (unreadable target)
    let a = d.join("a.txt");
    let b = d.join("b.txt");
    let blocked = d.join("blocked"); // a file, so /blocked/x can't be written
    std::fs::write(&blocked, "x").unwrap();
    let fail_path = blocked.join("x.txt");
    let r = apply_batch(&[
        (pre.clone(), "new-pre".into()),
        (a.clone(), "A".into()),
        (b.clone(), "B".into()),
        (fail_path.clone(), "F".into()),
    ]);
    match r {
        Err(ApplyError::WriteFailed { path, message }) => {
            assert_eq!(path, fail_path);
            assert_eq!(std::fs::read_to_string(&pre).unwrap(), "original-bytes", "pre-existing must be restored exactly");
            assert!(!a.exists() && !b.exists(), "created files must be deleted");
            let tree: Vec<String> = walk(&d);
            println!("clean: {}", tree.iter().filter(|s| s.contains("t6")).count());
            println!("OK WriteFailed path={:?} msg={}", path.file_name().unwrap(), message);
        }
        other => panic!("expected WriteFailed, got {:?}", other),
    }

    // RollbackIncomplete: make a created file un-removable (chmod 000 owned file? as root skip — use read-only dir trick not portable).
    // Instead simulate: restore of a pre-existing file fails when its dir is read-only.
    let d2 = std::env::temp_dir().join("t6_ro_999");
    let _ = std::fs::remove_dir_all(&d2);
    std::fs::create_dir_all(&d2).unwrap();
    let rofile = d2.join("ro.txt");
    std::fs::write(&rofile, "keep").unwrap();
    // second target's parent is blocked by an existing *file* so its write fails
    let blk = d2.join("blk");
    std::fs::write(&blk, "x").unwrap();
    let bad = blk.join("y");
    let r2 = apply_batch(&[
        (rofile.clone(), "changed".into()),
        (bad.clone(), "X".into()),
    ]);
    match r2 {
        Err(ApplyError::RollbackIncomplete { restored, failed }) => println!("OK RollbackIncomplete restored={:?} failed={:?}", restored, failed),
        Err(ApplyError::WriteFailed { path, .. }) => println!("got WriteFailed (rollback of rofile via write OK? path={})", path.display()),
        Ok(()) => panic!("should have failed"),
    }
}

fn walk(p: &std::path::Path) -> Vec<String> {
    let mut out = Vec::new();
    if let Ok(rd) = std::fs::read_dir(p) {
        for e in rd {
            let pp = e.unwrap().path();
            out.push(pp.display().to_string());
            if pp.is_dir() { let sub = walk(&pp); out.extend(sub); }
        }
    }
    out
}
EOF
