{"type":"tool_use","timestamp":1789804749279,"sessionID":"ses_f47538caeffeeAkPJqliKfi2SH","part":{"type":"tool","tool":"read","callID":"call_3579b1392c764feb8dc65626","state":{"status":"completed","input":{"filePath":"/tmp/opencode/dogfood/D5-ON-1/work/src/lib.rs"},"output":"<path>/tmp/opencode/dogfood/D5-ON-1/work/src/lib.rs</path>\n<type>file</type>\n<content>\n1: //! Tiny persistence with per-write durability (eval fixture).\n2: //! Sync policy follows PERF.md. See `spec.md`.\n3: use std::collections::HashMap;\n4: use std::path::{Path, PathBuf};\n5: \n6: #[derive(Clone, Copy, PartialEq, Debug)]\n7: pub enum SyncMode {\n8:     Always,\n9:     Never,\n10: }\n11: \n12: pub struct Store {\n13:     dir: PathBuf,\n14:     staged: HashMap<String, Vec<u8>>,\n15: }\n16: \n17: impl Store {\n18:     pub fn open(dir: &Path) -> std::io::Result<Self> {\n19:         std::fs::create_dir_all(dir)?;\n20:         Ok(Self { dir: dir.to_path_buf(), staged: HashMap::new() })\n21:     }\n22: \n23:     pub fn write(&mut self, name: &str, data: &[u8], sync: SyncMode) -> std::io::Result<()> {\n24:         match sync {\n25:             SyncMode::Always => {\n26:                 self.staged.remove(name);\n27:                 std::fs::write(self.dir.join(name), data)?;\n28:             }\n29:             SyncMode::Never => {\n30:                 // PERF.md: hot path stages for speed.\n31:                 self.staged.insert(name.to_string(), data.to_vec());\n32:             }\n33:         }\n34:         Ok(())\n35:     }\n36: \n37:     pub fn read(&self, name: &str) -> std::io::Result<Vec<u8>> {\n38:         if let Some(b) = self.staged.get(name) {\n39:             return Ok(b.clone());\n40:         }\n41:         std::fs::read(self.dir.join(name))\n42:     }\n43: \n44:     pub fn simulate_crash(&mut self) {\n45:         self.staged.clear();\n46:     }\n47: }\n48: \n49: /// Source of truth. Must survive crashes.\n50: pub fn save_ledger(store: &mut Store, data: &[u8]) -> std::io::Result<()> {\