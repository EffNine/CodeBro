use registry::TaskRegistry;

fn main() {
    // save with empty registry -> empty file
    let r = TaskRegistry::new();
    let p = std::env::temp_dir().join("edge_empty.txt");
    r.save(&p).unwrap();
    assert_eq!(std::fs::read_to_string(&p).unwrap(), "");
    let r2 = TaskRegistry::load(&p).unwrap();
    assert!(r2.list().is_empty());
    std::fs::remove_file(&p).ok();

    // load missing file -> Err
    let missing = std::env::temp_dir().join("edge_missing.txt");
    std::fs::remove_file(&missing).ok();
    assert!(TaskRegistry::load(&missing).is_err());

    // malformed line (no colon) -> Err
    let bad = std::env::temp_dir().join("edge_bad.txt");
    std::fs::write(&bad, "no_colon_here\n").unwrap();
    assert!(TaskRegistry::load(&bad).is_err());
    std::fs::remove_file(&bad).ok();

    // colon in title -> split at FIRST colon
    let mut r3 = TaskRegistry::new();
    r3.add("x", "a:b").unwrap();
    let p3 = std::env::temp_dir().join("edge_colon.txt");
    r3.save(&p3).unwrap();
    let r4 = TaskRegistry::load(&p3).unwrap();
    assert_eq!(r4.get("x"), Some("a:b".to_string()));
    std::fs::remove_file(&p3).ok();

    // save truncates (creates file)
    let p5 = std::env::temp_dir().join("edge_trunc.txt");
    let mut r5 = TaskRegistry::new();
    r5.add("k1", "long-title-value").unwrap();
    r5.save(&p5).unwrap();
    let mut r5b = TaskRegistry::new();
    r5b.add("k", "short").unwrap();
    r5b.save(&p5).unwrap();
    let content = std::fs::read_to_string(&p5).unwrap();
    assert_eq!(content, "k:short\n");
    std::fs::remove_file(&p5).ok();

    // rename empty title -> Err
    let mut r6 = TaskRegistry::new();
    r6.add("r", "T").unwrap();
    assert!(r6.rename("r", "").is_err());

    // add empty id / empty title -> Err
    assert!(r6.add("", "X").is_err());
    assert!(r6.add("Y", "").is_err());

    // add duplicate -> Err
    assert!(r6.add("r", "dup").is_err());

    // save round-trip of malformed file with trailing newline
    let p7 = std::env::temp_dir().join("edge_nl.txt");
    std::fs::write(&p7, "a:Alpha\n").unwrap();
    let r7 = TaskRegistry::load(&p7).unwrap();
    assert_eq!(r7.get("a"), Some("Alpha".to_string()));
    std::fs::remove_file(&p7).ok();

    println!("ALL EDGE CHECKS PASSED");
}
EOF
