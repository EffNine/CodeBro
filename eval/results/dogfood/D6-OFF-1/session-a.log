{"type":"tool_use","timestamp":1789806094007,"sessionID":"ses_f47441ec2ffeW4AUVzoWlCzlO5","part":{"type":"tool","tool":"write","callID":"call_0c41d29d5ea74cc0a5064d16","state":{"status":"completed","input":{"content":"use batchapply::{apply_batch, ApplyError};\nuse std::path::PathBuf;\n\nfn dir(name: &str) -> PathBuf {\n    let p = std::env::temp_dir().join(format!(\"t6_probe_{name}_{}\", std::process::id()));\n    let _ = std::fs::remove_dir_all(&p);\n    std::fs::create_dir_all(&p).unwrap();\n    p\n}\n\n#[test]\nfn mid_batch_failure_restores_preexisting_bytes() {\n    let d = dir(\"mid\");\n    std::fs::write(d.join(\"keep.txt\"), b\"orig-bytes\\n\".as_ref().unwrap()).unwrap();\n    let block = d.join(\"block\");\n    std::fs::write(&block, \"x\").unwrap();\n    let r = apply_batch(&[\n        (d.join(\"keep.txt\"), \"changed\".to_string()),\n        (d.join(\"new.txt\"), \"new\".to_string()),\n        (block.join(\"impossible\"), \"nope\".to_string()),\n    ]);\n    match r {\n        Err(ApplyError::WriteFailed { path, message }) => {\n            assert_eq!(path, block.join(\"impossible\"));\n            assert!(!message.is_empty());\n        }\n        other => panic!(\"expected clean WriteFailed, got {other:?}\"),\n    }\n    assert_eq!(std::fs::read(d.join(\"keep.txt\")).unwrap(), b\"orig-bytes\\n\");\n    assert!(!d.join(\"new.txt\").exists());\n    let _ = std::fs::remove_dir_all(&d);\n}\n\n#[test]\nfn no_stray_files_after_failure() {\n    let d = dir(\"stray\");\n    std::fs::write(d.join(\"seed\"), \"s\").unwrap();\n    let block = d.join(\"block\");\n    std::fs::write(&block, \"x\").unwrap();\n    let _ = apply_batch(&[\n        (d.join(\"one\"), \"1\".to_string()),\n        (block.join(\"two\"), \"2\".to_string()),\n    ]);\n    let names: Vec<_> = std::fs::read_dir(&d).unwrap().map(|e| e.unwrap().file_name().to_string_lossy().to_string()).collect();\n    assert!(names.iter().any(|n| n == \"seed\"), \"seed missing: {names:?}\");\n    assert!(names.iter().any(|n| n == \"block\"), \"block missing: {names:?}\");\n    assert!(!names.iter().any(|n| n == \"one\"), \"created file not rolled back: {names:?}\");\n    assert!(!names.iter().any(|n| n.starts_with(\".tmp\") || n.contains(\"bak\")), \"stray files: {names:?}\");\n    let _ = std::fs::remove_dir_all(&d);\n}\n","filePath":"/tmp/opencode/dogfood/D6-OFF-1/work/tests/probe_local.rs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/opencode/dogfood/D6-OFF-1/work/tests/probe_local.rs","exists":false,"truncated":false},"title":"tmp/opencode/dogfood/D6-OFF-1/work/tests/probe_local.rs","time":{"start":1789806093992,"end":1789806093997}},"id":"prt_0b8c1a3d20010xiaJ2ORjMadXB","sessionID":"ses_f47441ec2ffeW4AUVzoWlCzlO5","messageID":"msg_0b8c0ee380010Siup7MlvO4CP5"}}
