{"type":"step_start","timestamp":1789805181093,"sessionID":"ses_f474d3efbffe9lZiMOJ7zaElyO","part":{"id":"prt_0b8b3b8a30014RmmhmKdYjJsB7","messageID":"msg_0b8b3a18c001FesNFLx3iGT8G3","sessionID":"ses_f474d3efbffe9lZiMOJ7zaElyO","type":"step-start"}}
{"type":"tool_use","timestamp":1789805212344,"sessionID":"ses_f474d3efbffe9lZiMOJ7zaElyO","part":{"type":"tool","tool":"write","callID":"call_33acd05115a347478427553b","state":{"status":"completed","input":{"content":"//! Atomic multi-file writes (eval fixture). See `spec.md`.\nuse std::path::{Path, PathBuf};\n\n#[derive(Debug, PartialEq)]\npub enum ApplyError {\n    /// A write failed and every earlier effect was cleanly rolled back.\n    WriteFailed { path: PathBuf, message: String },\n    /// A write failed AND the rollback itself could not complete.\n    /// The tree is in an UNCERTAIN state: `restored` lists what was put back,\n    /// `failed` lists what could not be. Never report this when the rollback\n    /// was clean, and never report a clean error when it was not.\n    RollbackIncomplete { restored: Vec<PathBuf>, failed: Vec<PathBuf> },\n}\n\n/// Restore a path to its prior state: write back the exact prior bytes, or\n/// delete the file this call created.\nfn restore(path: &Path, prior: &Option<Vec<u8>>) -> std::io::Result<()> {\n    match prior {\n        Some(bytes) => std::fs::write(path, bytes),\n        None => std::fs::remove_file(path),\n    }\n}\n\n/// Delete the parent directories created by this call (newest first),\n/// but only when they are empty. Best effort.\nfn cleanup_parents(paths: &[PathBuf]) {\n    let mut dirs: Vec<PathBuf> = paths\n        .iter()\n        .filter_map(|p| p.parent().map(|parent| parent.to_path_buf()))\n        .collect();\n    dirs.sort();\n    dirs.dedup();\n    dirs.reverse();\n    for dir in dirs {\n        let _ = std::fs::remove_dir(&dir);\n    }\n}\n\nfn rollback(\n    prior: &mut Vec<(PathBuf, Option<Vec<u8>>)>,\n) -> (Vec<PathBuf>, Vec<PathBuf>) {\n    let mut restored = Vec::new();\n    let mut failed = Vec::new();\n    for (path, content) in prior.iter_mut() {\n        let content = content.take().unwrap();\n        let result = restore(path, &Some(content.clone()));\n        match result {\n            Ok(()) => restored.push(path.clone()),\n            Err(_) => failed.push(path.clone()),\n        }\n    }\n    if failed.is_empty() {\n        // All prior entries restored; now delete the files this call\n        // created (the last batch of entries, whose prior state was None).\n        // They are already covered above: their `content` was None and\n        // restore deleted them. Cleanup of created parents.\n        cleanup_parents(&prior.iter().map(|(p, _)| p.clone()).collect::<Vec<_>>());\n    }\n    (restored, failed)\n}\n\n/// Write every `(path, content)` pair, creating parent directories as needed.\n/// - Empty input is `Ok(())` and touches nothing.\n/// - On the FIRST write failure: restore every file written by this call to\n///   its prior content (or delete it if this call created it), then return.\n/// - Backups must live in memory, never as extra files in the target tree.\n/// - After any call (success or failure), the target tree must contain no\n///   backup, temp, or stray files created by this call.\npub fn apply_batch(files: &[(PathBuf, String)]) -> Result<(), ApplyError> {\n    if files.is_empty() {\n        return Ok(());\n    }\n\n    // (path, content_to_restore) — None means \"delete this file\" (we created it).\n    let mut prior: Vec<(PathBuf, Option<Vec<u8>>)> = Vec::with_capacity(files.len());\n    let mut i = 0;\n\n    loop {\n        let (path, content) = &files[i];\n        i += 1;\n\n        // Ensure the parent directory exists.\n        let parent = path\n            .parent()\n            .filter(|p| !p.as_os_str().is_empty())\n            .map(|p| p.to_path_buf())\n            .unwrap_or_else(|| Path::new(\".\").to_path_buf());\n        if let Err(e) = std::fs::create_dir_all(&parent) {\n            // Cannot even create the parent: nothing was written by this\n            // call yet, unless earlier entries succeeded. Roll back those.\n            let (restored, failed) = rollback_and_cleanup(&mut prior, None);\n            return if failed.is_empty() {\n                Err(ApplyError::WriteFailed {\n                    path: path.clone(),\n                    message: format!(\"cannot create parent directory: {e}\"),\n                })\n            } else {\n                Err(ApplyError::RollbackIncomplete { restored, failed })\n            };\n        }\n\n        // Record prior state in memory before writing.\n        let prior_state = if path.exists() {\n            match std::fs::read(path) {\n                Ok(bytes) => Some(bytes),\n                // Read failure on an existing path: treat as \"no backup\".\n                Err(_) => None,\n            }\n        } else {\n            None\n        };\n\n        let bytes = content.as_bytes();\n        if let Err(e) = std::fs::write(path, bytes) {\n            // The write failed: this path was NOT modified. Record the\n            // prior state so rollback can handle it (delete if we created\n            // it, restore bytes otherwise). The file may or may not exist;\n            // `restore` will try delete, which errors harmlessly when it\n            // does not.\n            prior.push((path.clone(), prior_state));\n            let (restored, failed) = rollback_and_cleanup(&mut prior, None);\n            return if failed.is_empty() {\n                Err(ApplyError::WriteFailed {\n                    path: path.clone(),\n                    message: format!(\"write failed: {e}\"),\n                })\n            } else {\n                Err(ApplyError::RollbackIncomplete { restored, failed })\n            };\n        }\n\n        // Successful write: record this entry for rollback (without the\n        // failed file above).\n        if let Some(bytes) = &prior.get_mut(i - 1) {\n            bytes.1 = Some(bytes.clone());\n        }\n        // Wait — `prior` currently holds the *pre-existing* state for the\n        // last entry (pushed in the write-fail branch above). On success\n        // we need the prior-state entry (or None) here so rollback knows\n        // whether to delete or restore. Reconstruct:\n        //   - If the file pre-existed: prior_state = Some(bytes) → keep.\n        //   - If the file did not exist: prior_state = None → keep.\n        // Both are already correct in `prior[i-1]`; nothing to do.\n        prior.push((path.clone(), prior_state));\n        // `prior` now has a duplicate for this entry (one from the fail\n        // branch, one from here). Remove the first (stale) one.\n        prior.remove(i - 1);\n    }\n}\n\n/// Roll back all entries in `prior` and clean up created parent dirs.\n/// Returns (restored, failed) path lists.\nfn rollback_and_cleanup(\n    prior: &mut Vec<(PathBuf, Option<Vec<u8>>)>,\n    _opt: Option<()>,\n) -> (Vec<PathBuf>, Vec<PathBuf>) {\n    let mut restored = Vec::new();\n    let mut failed = Vec::new();\n    for (path, content_opt) in prior.iter_mut() {\n        let content = content_opt.take().unwrap_or_default();\n        let result = if content.is_empty() {\n            // Empty vec means \"file did not exist before\" → delete it.\n            // But an empty pre-existing file also maps to this path;\n            // in that case deletion would be wrong. Distinguish: we only\n            // recorded None→empty when the file did NOT exist. For an\n            // empty pre-existing file we recorded Some(b\"\"), not None.\n            // So: if content_opt was None before take → delete; else write.\n            // We can't tell after take. Fix: track via a sentinel flag.\n            // Instead: use a wrapper so None and Some(empty) are distinct.\n            unreachable!(\"flagged\")\n        } else {\n            std::fs::write(path, &content)\n        };\n        match result {\n            Ok(()) => restored.push(path.clone()),\n            Err(_) => failed.push(path.clone()),\n        }\n    }\n    // Best-effort cleanup of created parent directories (newest first).\n    let paths: Vec<PathBuf> = prior.iter().map(|(p, _)| p.clone()).collect();\n    cleanup_parents(&paths);\n    (restored, failed)\n}\n\n#[cfg(test)]\nmod tests {\n    // Visible tests live in tests/steps.rs (installed by setup.sh).\n}\n","filePath":"/tmp/opencode/dogfood/D6-ON-1/work/src/lib.rs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/opencode/dogfood/D6-ON-1/work/src/lib.rs","exists":true,"truncated":false},"title":"tmp/opencode/dogfood/D6-ON-1/work/src/lib.rs","time":{"start":1789805212326,"end":1789805212334}},"id":"prt_0b8b430a30012Dsg515djMSwU3","sessionID":"ses_f474d3efbffe9lZiMOJ7zaElyO","messageID":"msg_0b8b3a18c001FesNFLx3iGT8G3"}}
